# JWT Signing Secret del Installed Package de SFMC. Obligatorio en Vercel.
JWT_SIGNING_SECRET=

# "simulado" no envía nada. Es el único modo disponible por ahora.
SEND_MODE=simulado

# Solo para probar en local sin JWT. No tiene efecto en Vercel.
ALLOW_UNSIGNED=true

# Opcional: URL pública fija. Si no está, se toma del host del request.
# PUBLIC_URL=https://tu-proyecto.vercel.app
